generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  name              String?
  email             String           @unique
  emailVerified     DateTime?
  image             String?
  password          String
  role              UserRole         @default(OWNER)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  accounts          Account[]
  locations         Location[]
  ownedRabbitries   Rabbitry[]       @relation("OwnedRabbitries")
  workerAssignments RabbitryWorker[]
  sessions          Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Location {
  id          String     @id @default(cuid())
  name        String
  description String?
  type        String
  address     String?
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rabbitries  Rabbitry[]
}

model Rabbitry {
  id          String           @id @default(cuid())
  name        String
  description String?
  locationId  String
  ownerId     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cages       Cage[]
  location    Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  owner       User             @relation("OwnedRabbitries", fields: [ownerId], references: [id], onDelete: Cascade)
  workers     RabbitryWorker[]
}

model RabbitryWorker {
  id         String   @id @default(cuid())
  rabbitryId String
  userId     String
  role       String   @default("worker")
  assignedAt DateTime @default(now())
  rabbitry   Rabbitry @relation(fields: [rabbitryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rabbitryId, userId])
}

model Cage {
  id               String           @id @default(cuid())
  cageId           String           @unique
  type             CageType
  rabbitryId       String
  capacity         Int              @default(1)
  compartments     Int              @default(1)
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  rabbitry         Rabbitry         @relation(fields: [rabbitryId], references: [id], onDelete: Cascade)
  offspringBatches OffspringBatch[]
  rabbits          Rabbit[]
}

model Rabbit {
  id                String              @id @default(cuid())
  rabbitId          String              @unique
  name              String?
  gender            RabbitGender
  breed             String
  dateOfBirth       DateTime?
  cageId            String
  status            RabbitStatus        @default(ACTIVE)
  healthStatus      HealthStatus        @default(HEALTHY)
  healthDescription String?
  color             String?
  motherId          String?
  fatherId          String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  compartment       Int                 @default(1)
  deaths            Death[]
  matingsAsBuck     Mating[]            @relation("BuckMatings")
  matingsAsDoe      Mating[]            @relation("DoeMatings")
  cage              Cage                @relation(fields: [cageId], references: [id])
  father            Rabbit?             @relation("RabbitSire", fields: [fatherId], references: [id])
  siredRabbits      Rabbit[]            @relation("RabbitSire")
  mother            Rabbit?             @relation("RabbitOffspring", fields: [motherId], references: [id])
  offspring         Rabbit[]            @relation("RabbitOffspring")
  sales             Sale[]
  weights           WeightMeasurement[]
}

model Mating {
  id                   String    @id @default(cuid())
  buckId               String
  doeId                String
  matingDate           DateTime
  expectedKindlingDate DateTime?
  successful           Boolean   @default(false)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  births               Birth[]
  buck                 Rabbit    @relation("BuckMatings", fields: [buckId], references: [id])
  doe                  Rabbit    @relation("DoeMatings", fields: [doeId], references: [id])
}

model Birth {
  id               String           @id @default(cuid())
  matingId         String
  birthDate        DateTime
  totalKits        Int
  aliveKits        Int
  deadKits         Int              @default(0)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  mating           Mating           @relation(fields: [matingId], references: [id], onDelete: Cascade)
  offspringBatches OffspringBatch[]
  offspringDeaths  OffspringDeath[]
}

model OffspringBatch {
  id                  String                        @id @default(cuid())
  batchId             String                        @unique
  birthId             String
  count               Int
  status              String                        @default("ACTIVE")
  notes               String?
  /// For new-style sexing: if this batch came from splitting another batch, link back to the source.
  /// Existing data will have this field null.
  sourceBatchId       String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  overallHealthStatus OffspringHealthStatus         @default(HEALTHY)
  cageId              String?
  compartment         Int?                          @default(1)
  maleCount           Int?
  femaleCount         Int?
  sexedAt             DateTime?                     @db.Timestamptz(6)
  birth               Birth                         @relation(fields: [birthId], references: [id], onDelete: Cascade)
  cage                Cage?                         @relation(fields: [cageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cage")
  healthHistory       OffspringBatchHealthHistory[]
  weights             OffspringWeight[]
}

model OffspringBatchHealthHistory {
  id        String                @id @default(cuid())
  batchId   String
  status    OffspringHealthStatus
  notes     String?
  createdAt DateTime              @default(now())
  batch     OffspringBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model OffspringDeath {
  id        String   @id @default(cuid())
  birthId   String
  deathDate DateTime
  count     Int      @default(1)
  cause     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  birth     Birth    @relation(fields: [birthId], references: [id], onDelete: Cascade)
}

model Death {
  id        String   @id @default(cuid())
  rabbitId  String
  deathDate DateTime
  cause     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rabbit    Rabbit   @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
}

model WeightMeasurement {
  id              String   @id @default(cuid())
  rabbitId        String
  weight          Float
  measurementDate DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rabbit          Rabbit   @relation(fields: [rabbitId], references: [id], onDelete: Cascade)
}

model OffspringWeight {
  id              String         @id @default(cuid())
  batchId         String
  weight          Float
  measurementDate DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  batch           OffspringBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Sale {
  id           String   @id @default(cuid())
  rabbitId     String?
  description  String
  amount       Float
  saleDate     DateTime
  buyerName    String?
  buyerContact String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rabbit       Rabbit?  @relation(fields: [rabbitId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Float
  expenseDate DateTime
  vendor      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Debtor {
  id           String   @id @default(cuid())
  name         String
  contact      String?
  amountOwed   Float
  description  String
  dueDate      DateTime?
  status       String   @default("PENDING") // PENDING, PAID, OVERDUE
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Creditor {
  id           String   @id @default(cuid())
  name         String
  contact      String?
  amountOwed   Float
  description  String
  dueDate      DateTime?
  status       String   @default("PENDING") // PENDING, PAID, OVERDUE
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // MATING, SEXING, BIRTH, DEATH, etc.
  title       String
  message     String
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  read        Boolean  @default(false)
  userId      String?  // null means visible to all users
  relatedId   String?  // ID of related entity (mating, batch, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  OWNER
  WORKER
}

enum CageType {
  BREEDING
  WEANER
}

enum RabbitGender {
  BUCK
  DOE
}

enum RabbitStatus {
  ACTIVE
  SOLD
  DECEASED
  WEANED
}

enum HealthStatus {
  HEALTHY
  SICK
  INJURED
}

enum OffspringHealthStatus {
  HEALTHY
  SICK
  INJURED
}

enum TransactionType {
  SALE
  EXPENSE
}
